# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
.next/
client/.next/
dist/
build/

# Test files
coverage/
.nyc_output/
test/
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Documentation and development
docs/
Recordings/
*.mp4
*.mov
*.avi

# Docker files (optional - comment out if you want to include them)
docker-compose.yaml
setup.compose.yaml
Dockerfile.dev

# Scripts that aren't needed in production
scripts/
# ...except nextBuild.js, which server/index.js imports directly for the
# production build fallback path (`import buildNextApp from "../scripts/nextBuild.js"`)
!scripts/nextBuild.js
.bin/

# Large arch-specific dev tooling and stray key/secret material — never publish
server/wheel
*.sk

# Git files
.git/
.gitignore

# Temporary files
tmp/
temp/
*.tmp

# Database files
*.db
*.sqlite
*.sqlite3
ceramic-state/
ceramic.db

# Logs
logs/
log/
*.log

# OS generated files
.DS_Store?
ehthumbs.db
Icon?

# npm only excludes the package's own root node_modules by default — nested
# ones (e.g. client/node_modules, recreated by Next.js's auto-install side
# effect) are NOT covered by that and must be excluded explicitly.
**/node_modules/

# Development dependencies
nodemon.json

# Configuration files that shouldn't be published
eslint.config.js
.eslintrc*
.prettierrc*
tailwind.config.cjs
postcss.config.mjs
